########################################################################
# Environment configuration template.
# Copy this file to `.env` and adjust values for your machine.
# Every variable here is read by app/core/config.py (class Settings).
########################################################################

# ---- App -------------------------------------------------------------
APP_NAME="RAG Platform"
APP_ENV=development          # development | testing | production
APP_DEBUG=true

# ---- Logging -----------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                 # true = structured JSON logs, false = human-readable

# ---- API server --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---- Ollama (local LLM runtime) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RAG_MODEL=llama3.2:3b
OLLAMA_FINETUNE_SMALL_MODEL=llama3.2:1b
OLLAMA_FINETUNE_LARGE_MODEL=mistral:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1

# ---- Embeddings (sentence-transformers, runs locally / free) ------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps

# ---- Document ingestion & chunking ---------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
INGESTION_SOURCE_DIR=./data/raw
INGESTION_SUPPORTED_EXTENSIONS=.pdf,.docx,.html,.md

# ---- FAISS vector store ----------------------------------------------------
FAISS_INDEX_DIR=./data/faiss_index
FAISS_TOP_K=5

# ---- Hybrid retrieval / reranking -------------------------------------------
RETRIEVAL_DENSE_WEIGHT=0.5
RETRIEVAL_SPARSE_WEIGHT=0.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=3

# ---- Fine-tuning (Colab / Kaggle GPU) -----------------------------------------
FINETUNE_BASE_MODEL=meta-llama/Llama-3.2-1B
FINETUNE_OUTPUT_DIR=./data/adapters
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

# ---- Evaluation --------------------------------------------------------------
EVAL_TEST_SET_PATH=./data/eval/test_questions.json
EVAL_REPORT_DIR=./data/eval/reports

# ---- Observability (Prometheus) -----------------------------------------------
PROMETHEUS_METRICS_PATH=/metrics
